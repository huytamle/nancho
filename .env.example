# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit .env.local, KHÔNG dán mật khẩu vào chat.
# Mô tả từng biến: docs/BLUEPRINT.md §5.6. Secret ngẫu nhiên: openssl rand -base64 32

# ── Database (Supabase, region Mumbai ap-south-1) — Project Settings → Database → Connection string ──
# App: Transaction pooler, cổng 6543
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Migration: Session pooler / kết nối trực tiếp, cổng 5432
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Bảo mật (≥ 32 byte ngẫu nhiên) ──
# SESSION_SECRET: ký phiên nhân viên (JWT). Nhân viên & PIN: npm run staff -- "Tên" owner 123456
SESSION_SECRET=
CUSTOMER_COOKIE_SECRET=
# CRON_SECRET: Vercel Cron tự gửi "Authorization: Bearer <CRON_SECRET>" tới /api/cron/daily (vercel.json)
CRON_SECRET=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://theheatpizza.vn

# ── Telegram (M4): tạo bot qua @BotFather; chat id của nhóm "Bếp The Heat" ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Thanh toán (M6) ──
# VietQR: mã BIN 6 số của ngân hàng (vd Vietcombank 970436), số TK, tên chủ TK (IN HOA, không dấu). Thiếu → không hiện QR.
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Tuỳ chọn — tên ngân hàng hiển thị cạnh số TK
VIETQR_BANK_NAME=
# SePay → Webhooks: URL https://theheatpizza.vn/api/webhooks/sepay, kiểu chứng thực "API Key" = giá trị này
SEPAY_WEBHOOK_KEY=

# ── Chỉ khi tự host nhiều instance (Phương án B) ──
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
