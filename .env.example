# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit file .env.local.
# Mô tả từng biến: docs/BLUEPRINT.md §5.6

# Supabase — transaction pooler (cổng 6543), dùng cho app
DATABASE_URL=
# Supabase — kết nối trực tiếp/session (cổng 5432), chỉ dùng cho migration
DIRECT_URL=

# ≥ 32 byte ngẫu nhiên (vd: openssl rand -base64 32)
SESSION_SECRET=
CUSTOMER_COOKIE_SECRET=

NEXT_PUBLIC_SITE_URL=https://theheatpizza.vn

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CRON_SECRET=

# M6 — thanh toán
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
SEPAY_WEBHOOK_KEY=

# Chỉ khi tự host nhiều instance (Phương án B)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
